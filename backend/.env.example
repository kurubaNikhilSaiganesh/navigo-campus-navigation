# ================================================================
# NaviGO Backend — Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ================================================================

# ─── Supabase (server-side only) ──────────────────────────────────
# Get from: https://supabase.com → Project → Settings → API
SUPABASE_URL=https://frkdzjipdewlxiffdaux.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ─── App ──────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── CORS ─────────────────────────────────────────────────────────
# Frontend URL (for CORS allow-list)
FRONTEND_URL=http://localhost:5173

# ─── Admin ────────────────────────────────────────────────────────
# PIN used as Bearer token for admin endpoints when Supabase Auth is not used
ADMIN_PIN=alts2026

# ─── Navigation ───────────────────────────────────────────────────
# Average walking speed in metres per minute (used for ETA calculation)
WALKING_SPEED_M_PER_MIN=80
